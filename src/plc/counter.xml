<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="" productName="Agent Pipeline" productVersion="0.2.0"
              creationDateTime="2026-09-01T10:00:00"
              description="Smoke test: DINT counter incremented by 1 every second. cnt is bound to Modbus holding register 0 via %QW0 (OpenPLC runtime)." />
  <contentHeader name="counter.project" modificationDateTime="2026-09-01T10:00:00">
    <coordinateInfo>
      <fbd>
        <scaling x="1" y="1" />
      </fbd>
      <ld>
        <scaling x="1" y="1" />
      </ld>
      <sfc>
        <scaling x="1" y="1" />
      </sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes />
    <pous>
      <pou name="PLC_PRG" pouType="program">
        <interface>
          <localVars>
            <variable name="pulse">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <!-- AT 地址即对外接口：%QW0 -> Modbus 保持寄存器 0（INT 16位，位宽必须匹配：
                 BOOL->%QX  INT/UINT/WORD->%QW。%QD 不映射 Modbus，禁用） -->
            <variable name="cnt" address="%QW0">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
            </variable>
            <variable name="prog_id" address="%QW20">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="1" />
              </initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* program identity (scenario = counter) *)
prog_id := 1;
pulse(IN := NOT pulse.Q, PT := T#1S);
IF pulse.Q THEN
    cnt := cnt + 1;
END_IF;</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
</project>
