all_oe := pwr_x.Status AND pwr_y.Status AND pwr_z.Status;
move_done := go_x.Done AND go_y.Done AND go_z.Done;
any_moving := (x_v &lt;&gt; 0) OR (y_v &lt;&gt; 0) OR (z_v &lt;&gt; 0);
fault_any := (x_sw AND 16#0008) &lt;&gt; 0 OR (y_sw AND 16#0008) &lt;&gt; 0 OR (z_sw AND 16#0008) &lt;&gt; 0;</xhtml>
