    <pous>
      <pou name="INTERP" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire">
              <type><BOOL /></type>
            </variable>
            <variable name="pos_target">
              <type><INT /></type>
            </variable>
            <variable name="hold_req">
              <type><BOOL /></type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Setpoint">
              <type><INT /></type>
            </variable>
            <variable name="Busy">
              <type><BOOL /></type>
            </variable>
            <variable name="Done">
              <type><BOOL /></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="edge_ir">
              <type><BOOL /></type>
            </variable>
            <variable name="pos">
              <type><REAL /></type>
            </variable>
            <variable name="vel">
              <type><REAL /></type>
            </variable>
            <variable name="tgt">
              <type><REAL /></type>
            </variable>
            <variable name="dist">
              <type><REAL /></type>
            </variable>
            <variable name="stop_d">
              <type><REAL /></type>
            </variable>
            <variable name="SCAN_T">
              <type><REAL /></type>
              <initialValue><simpleValue value="0.02" /></initialValue>
            </variable>
            <variable name="VMAX">
              <type><REAL /></type>
              <initialValue><simpleValue value="40.0" /></initialValue>
            </variable>
            <variable name="ACCEL">
              <type><REAL /></type>
              <initialValue><simpleValue value="80.0" /></initialValue>
            </variable>
            <variable name="POSWIN">
              <type><REAL /></type>
              <initialValue><simpleValue value="2.0" /></initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF fire AND NOT edge_ir THEN
    IF pos_target &gt; 100 OR pos_target &lt; 0 THEN
        (* 目标越程: 不启动插补, 保持原位 *)
        Done := TRUE;
    ELSE
        tgt := INT_TO_REAL(pos_target);
        Busy := TRUE;
        Done := FALSE;
    END_IF;
END_IF;
edge_ir := fire;

IF hold_req THEN
    IF vel &gt; 0.0 THEN vel := MAX(0.0, vel - ACCEL * SCAN_T);
    ELSIF vel &lt; 0.0 THEN vel := MIN(0.0, vel + ACCEL * SCAN_T);
    END_IF;
ELSIF Busy THEN
    dist := tgt - pos;
    stop_d := (vel * vel) / (2.0 * ACCEL);
    IF ABS(dist) &lt;= stop_d THEN
        IF dist &gt;= 0.0 THEN vel := MAX(0.0, vel - ACCEL * SCAN_T);
        ELSE vel := MIN(0.0, vel + ACCEL * SCAN_T);
        END_IF;
        IF vel = 0.0 AND ABS(dist) &lt;= POSWIN THEN
            pos := tgt;
            Busy := FALSE;
            Done := TRUE;
        END_IF;
    ELSE
        IF dist &gt; 0.0 THEN vel := MIN(VMAX, vel + ACCEL * SCAN_T);
        ELSE vel := MAX(-VMAX, vel - ACCEL * SCAN_T);
        END_IF;
    END_IF;
END_IF;

pos := pos + vel * SCAN_T;
Setpoint := REAL_TO_INT(pos);</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="DRIVE402" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="cw">
              <type><WORD /></type>
            </variable>
            <variable name="Setpoint">
              <type><INT /></type>
            </variable>
            <variable name="pos_fb">
              <type><INT /></type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="sw">
              <type><WORD /></type>
            </variable>
            <variable name="v_cmd">
              <type><INT /></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="state">
              <type><INT /></type>
              <initialValue><simpleValue value="1" /></initialValue>
            </variable>
            <variable name="cmd">
              <type><WORD /></type>
            </variable>
            <variable name="pos_err">
              <type><REAL /></type>
            </variable>
            <variable name="v_ff">
              <type><REAL /></type>
            </variable>
            <variable name="v_out">
              <type><REAL /></type>
            </variable>
            <variable name="sp_prev">
              <type><INT /></type>
            </variable>
          </localVars>
          <localVars>
            <variable name="SCAN_T">
              <type><REAL /></type>
              <initialValue><simpleValue value="0.02" /></initialValue>
            </variable>
            <variable name="KP">
              <type><REAL /></type>
              <initialValue><simpleValue value="25.0" /></initialValue>
            </variable>
            <variable name="QS_DECEL">
              <type><REAL /></type>
              <initialValue><simpleValue value="120.0" /></initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============ DRIVE402: 驱动器（CSP 跟随 + 位置环）============ *)
(* 接收周期位置设定点（插补点），闭位置环，输出电机速度指令。 *)
(* 不含轨迹规划——那是 PLC 侧 INTERP 的事。                  *)
(* state: 1=SOD 2=RTSO 3=SO 4=OE 5=QSA 6=FRA 7=FA           *)

cmd := cw AND 16#000F;

IF state = 7 AND (cw AND 16#0080) &lt;&gt; 0 THEN
    state := 1;
END_IF;

CASE state OF
    1: IF cmd = 16#06 THEN state := 2; END_IF;
    2: IF cmd = 16#07 THEN state := 3;
       ELSIF cmd = 16#0F THEN state := 4;
       ELSIF cmd = 16#00 THEN state := 1;
       END_IF;
    3: IF cmd = 16#0F THEN state := 4;
       ELSIF cmd = 16#06 THEN state := 2;
       ELSIF cmd = 16#00 THEN state := 1;
       ELSIF cmd = 16#02 THEN state := 5;
       END_IF;
    4: IF cmd = 16#07 THEN state := 3;
       ELSIF cmd = 16#06 THEN state := 2;
       ELSIF cmd = 16#00 THEN state := 1;
       ELSIF cmd = 16#02 THEN state := 5;
       END_IF;
    5: IF v_out = 0.0 THEN
           IF cmd = 16#0F THEN state := 4;
           ELSIF cmd = 16#06 THEN state := 2;
           ELSIF cmd = 16#00 THEN state := 1;
           END_IF;
       END_IF;
    6: IF v_out = 0.0 THEN state := 7; END_IF;
END_CASE;

(* ---- 位置环：P 控制 + 设定值差分前馈 ---- *)
IF state &gt;= 4 AND state &lt;= 6 THEN
    v_ff := INT_TO_REAL(Setpoint - sp_prev) / SCAN_T;
    pos_err := INT_TO_REAL(Setpoint) - INT_TO_REAL(pos_fb);
    v_out := v_ff + KP * pos_err;
    IF v_out &gt; 120.0 THEN v_out := 120.0; END_IF;
    IF v_out &lt; -120.0 THEN v_out := -120.0; END_IF;
    IF v_ff = 0.0 AND ABS(pos_err) &lt;= 1.5 THEN
        v_out := 0.0;
    END_IF;
ELSIF state = 5 THEN
    IF v_out &gt; 0.0 THEN v_out := MAX(0.0, v_out - QS_DECEL * SCAN_T);
    ELSIF v_out &lt; 0.0 THEN v_out := MIN(0.0, v_out + QS_DECEL * SCAN_T);
    END_IF;
ELSE
    v_out := 0.0;
END_IF;

sp_prev := Setpoint;
v_cmd := REAL_TO_INT(v_out);

sw := 0;
CASE state OF
    1: sw := 16#0040;
    2: sw := 16#0031;
    3: sw := 16#0033;
    4: sw := 16#0037;
    5: sw := 16#0014;
    7: sw := 16#0018;
END_CASE;
IF state = 4 THEN
    IF ABS(pos_err) &lt;= 2.0 AND v_ff = 0.0 THEN
        sw := sw OR 16#0400;
    END_IF;
END_IF;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="MC_POWER" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable">
              <type><BOOL /></type>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="cw">
              <type><WORD /></type>
            </variable>
            <variable name="sw">
              <type><WORD /></type>
            </variable>
          </inOutVars>
          <outputVars>
            <variable name="Status">
              <type><BOOL /></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="pstep">
              <type><INT /></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF Enable AND pstep = 4 AND (sw AND 16#0004) = 0 AND (sw AND 16#0008) = 0 THEN
    pstep := 0;
END_IF;
IF Enable THEN
    CASE pstep OF
        0: cw := (cw AND 16#00F0) OR 16#0006;  pstep := 1;
        1: IF (sw AND 16#0001) &lt;&gt; 0 THEN cw := (cw AND 16#00F0) OR 16#0007; pstep := 2; END_IF;
        2: IF (sw AND 16#0002) &lt;&gt; 0 THEN cw := (cw AND 16#00F0) OR 16#000F; pstep := 3; END_IF;
        3: IF (sw AND 16#0004) &lt;&gt; 0 THEN pstep := 4; END_IF;
    END_CASE;
ELSE
    cw := (cw AND 16#00F0) OR 16#0006;
    pstep := 0;
END_IF;
Status := (sw AND 16#0004) &lt;&gt; 0;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="MC_RESET" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire">
              <type><BOOL /></type>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="cw">
              <type><WORD /></type>
            </variable>
            <variable name="sw">
              <type><WORD /></type>
            </variable>
          </inOutVars>
          <outputVars>
            <variable name="Done">
              <type><BOOL /></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="edge_rs">
              <type><BOOL /></type>
            </variable>
            <variable name="busy">
              <type><BOOL /></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF fire AND NOT edge_rs THEN
    busy := TRUE;
END_IF;
edge_rs := fire;
IF busy THEN
    IF (sw AND 16#0008) &lt;&gt; 0 THEN
        cw := cw OR 16#0080;
    ELSE
        cw := cw AND 16#FF7F;
        busy := FALSE;
    END_IF;
END_IF;
Done := NOT busy AND (sw AND 16#0008) = 0 AND NOT fire;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="MC_STOP" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire">
              <type><BOOL /></type>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="cw">
              <type><WORD /></type>
            </variable>
            <variable name="sw">
              <type><WORD /></type>
            </variable>
          </inOutVars>
          <outputVars>
            <variable name="Done">
              <type><BOOL /></type>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF fire THEN
    cw := (cw AND 16#00F0) OR 16#0002;
    Done := FALSE;
ELSE
    Done := TRUE;
END_IF;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="MC_MOVEABSOLUTE" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire">
              <type><BOOL /></type>
            </variable>
            <variable name="Position">
              <type><INT /></type>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="interp_exe">
              <type><BOOL /></type>
            </variable>
          </inOutVars>
          <outputVars>
            <variable name="Done">
              <type><BOOL /></type>
            </variable>
            <variable name="Busy">
              <type><BOOL /></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="edge_ma">
              <type><BOOL /></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* 触发插补引擎的 fire 线 *)
IF fire AND NOT edge_ma THEN
    interp_exe := TRUE;
END_IF;
edge_ma := fire;
(* interp_exe 保持 TRUE 直到运动完成(由 PLC_PRG 的 INTERP.Done 清零) *)
Done := NOT interp_exe;
Busy := interp_exe;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="MC_MOVEJOG" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="JogForward">
              <type><BOOL /></type>
            </variable>
            <variable name="JogBackward">
              <type><BOOL /></type>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="jog_pos">
              <type><INT /></type>
            </variable>
          </inOutVars>
          <outputVars>
            <variable name="Busy">
              <type><BOOL /></type>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF JogForward AND jog_pos &lt; 97 THEN
    jog_pos := jog_pos + 1;
ELSIF JogBackward AND jog_pos &gt; 3 THEN
    jog_pos := jog_pos - 1;
END_IF;
Busy := JogForward OR JogBackward;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="MC_HOME" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire">
              <type><BOOL /></type>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="home_exe">
              <type><BOOL /></type>
            </variable>
          </inOutVars>
          <outputVars>
            <variable name="Done">
              <type><BOOL /></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="edge_hm">
              <type><BOOL /></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF fire AND NOT edge_hm THEN
    home_exe := TRUE;
END_IF;
edge_hm := fire;
(* home_exe 保持 TRUE 直到运动完成 *)
Done := NOT home_exe;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="PLC_PRG" pouType="program">
        <interface>
          <localVars>
            <variable name="run" address="%QX0.0">
              <type><BOOL /></type>
            </variable>
            <variable name="cmd_home" address="%QX0.1">
              <type><BOOL /></type>
            </variable>
            <variable name="cmd_go" address="%QX0.2">
              <type><BOOL /></type>
            </variable>
            <variable name="jog_fwd" address="%QX0.3">
              <type><BOOL /></type>
            </variable>
            <variable name="jog_rev" address="%QX0.4">
              <type><BOOL /></type>
            </variable>
            <variable name="quickstop" address="%QX0.5">
              <type><BOOL /></type>
            </variable>
            <variable name="inject_fault" address="%QX0.6">
              <type><BOOL /></type>
            </variable>
            <variable name="cmd_reset" address="%QX0.7">
              <type><BOOL /></type>
            </variable>
          </localVars>
          <localVars>
            <variable name="x_fb" address="%QW0">
              <type><INT /></type>
            </variable>
            <variable name="y_fb" address="%QW1">
              <type><INT /></type>
            </variable>
            <variable name="z_fb" address="%QW2">
              <type><INT /></type>
            </variable>
          </localVars>
          <localVars>
            <variable name="x_sp" address="%QW10">
              <type><INT /></type>
            </variable>
            <variable name="y_sp" address="%QW11">
              <type><INT /></type>
            </variable>
            <variable name="z_sp" address="%QW12">
              <type><INT /></type>
            </variable>
          </localVars>
          <localVars>
            <variable name="x_sw" address="%QW6">
              <type><WORD /></type>
            </variable>
            <variable name="y_sw" address="%QW7">
              <type><WORD /></type>
            </variable>
            <variable name="z_sw" address="%QW8">
              <type><WORD /></type>
            </variable>
            <variable name="x_v" address="%QW13">
              <type><INT /></type>
            </variable>
            <variable name="y_v" address="%QW14">
              <type><INT /></type>
            </variable>
            <variable name="z_v" address="%QW15">
              <type><INT /></type>
            </variable>
            <variable name="all_oe" address="%QX1.0">
              <type><BOOL /></type>
            </variable>
            <variable name="move_done" address="%QX1.1">
              <type><BOOL /></type>
            </variable>
            <variable name="any_moving" address="%QX1.2">
              <type><BOOL /></type>
            </variable>
            <variable name="fault_any" address="%QX1.3">
              <type><BOOL /></type>
            </variable>
            <variable name="prog_id" address="%QW20">
              <type><INT /></type>
              <initialValue><simpleValue value="1" /></initialValue>
            </variable>
          </localVars>
          <localVars>
            <variable name="x_cw">
              <type><WORD /></type>
            </variable>
            <variable name="y_cw">
              <type><WORD /></type>
            </variable>
            <variable name="z_cw">
              <type><WORD /></type>
            </variable>
            <variable name="x_interp">
              <type><INT /></type>
            </variable>
            <variable name="y_interp">
              <type><INT /></type>
            </variable>
            <variable name="z_interp">
              <type><INT /></type>
            </variable>
            <variable name="x_jog_pos">
              <type><INT /></type>
            </variable>
            <variable name="go_x_exe">
              <type><BOOL /></type>
            </variable>
            <variable name="go_y_exe">
              <type><BOOL /></type>
            </variable>
            <variable name="go_z_exe">
              <type><BOOL /></type>
            </variable>
            <variable name="hm_x_exe">
              <type><BOOL /></type>
            </variable>
            <variable name="hm_y_exe">
              <type><BOOL /></type>
            </variable>
            <variable name="hm_z_exe">
              <type><BOOL /></type>
            </variable>
          </localVars>
          <localVars>
            <variable name="pwr_x">
              <type><derived name="MC_POWER" /></type>
            </variable>
            <variable name="pwr_y">
              <type><derived name="MC_POWER" /></type>
            </variable>
            <variable name="pwr_z">
              <type><derived name="MC_POWER" /></type>
            </variable>
            <variable name="rs_x">
              <type><derived name="MC_RESET" /></type>
            </variable>
            <variable name="st_x">
              <type><derived name="MC_STOP" /></type>
            </variable>
            <variable name="st_y">
              <type><derived name="MC_STOP" /></type>
            </variable>
            <variable name="st_z">
              <type><derived name="MC_STOP" /></type>
            </variable>
            <variable name="go_x">
              <type><derived name="MC_MOVEABSOLUTE" /></type>
            </variable>
            <variable name="go_y">
              <type><derived name="MC_MOVEABSOLUTE" /></type>
            </variable>
            <variable name="go_z">
              <type><derived name="MC_MOVEABSOLUTE" /></type>
            </variable>
            <variable name="jg_x">
              <type><derived name="MC_MOVEJOG" /></type>
            </variable>
            <variable name="hm_x">
              <type><derived name="MC_HOME" /></type>
            </variable>
            <variable name="hm_y">
              <type><derived name="MC_HOME" /></type>
            </variable>
            <variable name="hm_z">
              <type><derived name="MC_HOME" /></type>
            </variable>
            <variable name="ix_x">
              <type><derived name="INTERP" /></type>
            </variable>
            <variable name="ix_y">
              <type><derived name="INTERP" /></type>
            </variable>
            <variable name="ix_z">
              <type><derived name="INTERP" /></type>
            </variable>
            <variable name="dv_x">
              <type><derived name="DRIVE402" /></type>
            </variable>
            <variable name="dv_y">
              <type><derived name="DRIVE402" /></type>
            </variable>
            <variable name="dv_z">
              <type><derived name="DRIVE402" /></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ---- program identity ---- *)
prog_id := 1;

(* ---- 扫描头：采样驱动器状态 ---- *)
x_sw := dv_x.sw;
y_sw := dv_y.sw;
z_sw := dv_z.sw;

(* ---- 使能 / 复位 / 快停（快停最后落笔 = 优先级最高） ---- *)
pwr_x(Enable := run AND NOT quickstop, cw := x_cw, sw := x_sw);
pwr_y(Enable := run AND NOT quickstop, cw := y_cw, sw := y_sw);
pwr_z(Enable := run AND NOT quickstop, cw := z_cw, sw := z_sw);
rs_x(fire := cmd_reset, cw := x_cw, sw := x_sw);
st_x(fire := quickstop, cw := x_cw, sw := x_sw);
st_y(fire := quickstop, cw := y_cw, sw := y_sw);
st_z(fire := quickstop, cw := z_cw, sw := z_sw);

(* ---- MC 指令层 → 触发插补引擎 ---- *)
go_x(fire := cmd_go, Position := x_sp, interp_exe := go_x_exe);
go_y(fire := cmd_go, Position := y_sp, interp_exe := go_y_exe);
go_z(fire := cmd_go, Position := z_sp, interp_exe := go_z_exe);
hm_x(fire := cmd_home, home_exe := hm_x_exe);
hm_y(fire := cmd_home, home_exe := hm_y_exe);
hm_z(fire := cmd_home, home_exe := hm_z_exe);
jg_x(JogForward := jog_fwd, JogBackward := jog_rev, jog_pos := x_jog_pos);

(* ---- 插补引擎：每扫描输出插补点（回零时目标强制 0） ---- *)
ix_x(fire := go_x_exe OR hm_x_exe, pos_target := x_sp, hold_req := FALSE);
ix_y(fire := go_y_exe OR hm_y_exe, pos_target := y_sp, hold_req := FALSE);
ix_z(fire := go_z_exe OR hm_z_exe, pos_target := z_sp, hold_req := FALSE);

(* ---- INTERP 完成后清触发线 ---- *)
IF ix_x.Done THEN go_x_exe := FALSE; hm_x_exe := FALSE; END_IF;
IF ix_y.Done THEN go_y_exe := FALSE; hm_y_exe := FALSE; END_IF;
IF ix_z.Done THEN go_z_exe := FALSE; hm_z_exe := FALSE; END_IF;

(* ---- 插补点路由：点动时用 jog_pos，否则用 INTERP 输出 ---- *)
IF jg_x.Busy THEN
    x_interp := x_jog_pos;
ELSE
    x_interp := ix_x.Setpoint;
END_IF;
y_interp := ix_y.Setpoint;
z_interp := ix_z.Setpoint;

