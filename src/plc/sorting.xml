  </contentHeader>
  <types>
    <dataTypes />
    <pous>
      <!-- 上升沿检测功能块：演示 VAR_INPUT / VAR_OUTPUT 接口的完整转换 -->
      <pou name="EdgeFB" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="clk">
              <type><BOOL /></type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="rising">
              <type><BOOL /></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="last">
              <type><BOOL /></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">rising := clk AND NOT last;
last := clk;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="PLC_PRG" pouType="program">
        <interface>
          <!-- 内部状态：功能块实例与中间标志，不对外发布 -->
          <localVars>
            <variable name="edge_total">
              <type><derived name="EdgeFB" /></type>
            </variable>
            <variable name="edge_reject">
              <type><derived name="EdgeFB" /></type>
            </variable>
            <variable name="pusher_delay">
              <type><derived name="TON" /></type>
            </variable>
            <variable name="pusher_hold">
              <type><derived name="TON" /></type>
            </variable>
            <variable name="reject_pending">
              <type><BOOL /></type>
            </variable>
            <variable name="pusher_on">
              <type><BOOL /></type>
            </variable>
          </localVars>
          <!-- 对外接口-输入侧：按钮与光电传感器（仿真环境写入这些位） -->
          <localVars>
            <variable name="start_btn" address="%QX0.0">
              <type><BOOL /></type>
            </variable>
            <variable name="stop_btn" address="%QX0.1">
              <type><BOOL /></type>
            </variable>
            <variable name="e_stop" address="%QX0.2">
              <type><BOOL /></type>
            </variable>
            <variable name="photo_inlet" address="%QX0.3">
              <type><BOOL /></type>
            </variable>
            <variable name="photo_reject" address="%QX0.4">
              <type><BOOL /></type>
            </variable>
          </localVars>
          <!-- 对外接口-输出侧：执行器（线圈 8~10）与统计（保持寄存器 10~11） -->
          <localVars>
            <variable name="motor" address="%QX1.0">
              <type><BOOL /></type>
            </variable>
            <variable name="pusher" address="%QX1.1">
              <type><BOOL /></type>
            </variable>
            <variable name="alarm" address="%QX1.2">
              <type><BOOL /></type>
            </variable>
            <variable name="total_cnt" address="%QW10">
              <type><INT /></type>
              <initialValue><simpleValue value="0" /></initialValue>
            </variable>
            <variable name="reject_cnt" address="%QW11">
              <type><INT /></type>
              <initialValue><simpleValue value="0" /></initialValue>
            </variable>
            <variable name="prog_id" address="%QW20">
              <type><INT /></type>
              <initialValue><simpleValue value="2" /></initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ---- program identity (scenario = sorting) ---- *)
prog_id := 2;

(* ---- start/stop latch with e-stop ---- *)
motor := (start_btn OR motor) AND NOT stop_btn AND NOT e_stop;
alarm := e_stop;

(* ---- invoke every FB once per scan ---- *)
edge_total(clk := photo_inlet);
edge_reject(clk := photo_reject);
pusher_delay(IN := reject_pending, PT := T#300MS);
pusher_hold(IN := pusher_on, PT := T#500MS);

(* ---- part counting on rising edge, only while conveyor runs ---- *)
IF motor AND edge_total.rising THEN
    total_cnt := total_cnt + 1;
END_IF;

(* ---- reject sequence: detect -&gt; wait 300ms -&gt; extend 500ms -&gt; retract ---- *)
IF motor AND edge_reject.rising THEN
    reject_pending := TRUE;
    reject_cnt := reject_cnt + 1;
END_IF;
IF reject_pending AND pusher_delay.Q THEN
    pusher_on := TRUE;
END_IF;
IF pusher_on AND pusher_hold.Q THEN
    pusher_on := FALSE;
    reject_pending := FALSE;
END_IF;
pusher := pusher_on;</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
