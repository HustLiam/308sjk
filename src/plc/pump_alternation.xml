<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="" productName="Agent Pipeline" productVersion="0.3.0"
              creationDateTime="2026-09-01T13:00:00"
              description="Discrete-industry demo: dual-pump level control with hysteresis band, pump alternation (wear leveling) and minimum run-time protection." />
  <contentHeader name="pump_alternation.project" modificationDateTime="2026-09-01T13:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1" /></fbd>
      <ld><scaling x="1" y="1" /></ld>
      <sfc><scaling x="1" y="1" /></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes />
    <pous>
      <pou name="PLC_PRG" pouType="program">
        <interface>
          <!-- 内部状态 -->
          <localVars>
            <variable name="pumping">
              <type><BOOL /></type>
            </variable>
            <variable name="lead">
              <type><BOOL /></type>
              <initialValue><simpleValue value="FALSE" /></initialValue>
            </variable>
            <variable name="min_run">
              <type><derived name="TON" /></type>
            </variable>
          </localVars>
          <!-- 对外接口-输入：使能与液位（0~100，仿真侧写入） -->
          <localVars>
            <variable name="auto_mode" address="%QX0.0">
              <type><BOOL /></type>
            </variable>
            <variable name="level" address="%QW0">
              <type><INT /></type>
            </variable>
          </localVars>
          <!-- 对外接口-输出：双泵/低液位报警/启动周期数 -->
          <localVars>
            <variable name="pump1" address="%QX1.0">
              <type><BOOL /></type>
            </variable>
            <variable name="pump2" address="%QX1.1">
              <type><BOOL /></type>
            </variable>
            <variable name="low_alarm" address="%QX1.2">
              <type><BOOL /></type>
            </variable>
            <variable name="cycles" address="%QW10">
              <type><INT /></type>
              <initialValue><simpleValue value="0" /></initialValue>
            </variable>
            <variable name="prog_id" address="%QW20">
              <type><INT /></type>
              <initialValue><simpleValue value="3" /></initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ---- program identity (scenario = pump_alternation) ---- *)
prog_id := 3;

(* ---- minimum run time: 3s anti short-cycling ---- *)
min_run(IN := pumping, PT := T#3S);

(* ---- leaving auto mode stops the pumps immediately ---- *)
IF NOT auto_mode THEN
    pumping := FALSE;
END_IF;

(* ---- start / stop with hysteresis band (start &lt;30, stop &gt;80) ---- *)
IF auto_mode AND NOT pumping AND level &lt; 30 THEN
    pumping := TRUE;
    lead := NOT lead;            (* alternate lead pump each start cycle *)
    cycles := cycles + 1;
END_IF;
IF pumping AND min_run.Q AND level &gt; 80 THEN
    pumping := FALSE;
END_IF;

(* ---- pump outputs follow the lead selection ---- *)
pump1 := pumping AND lead;
pump2 := pumping AND NOT lead;

(* ---- low level alarm ---- *)
low_alarm := auto_mode AND (level &lt; 10);</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
</project>
