<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="" productName="Agent Pipeline" productVersion="0.3.0"
              creationDateTime="2026-09-01T13:30:00"
              description="Discrete-industry demo: crossroad traffic light as a timer-chain state machine (NS/EW green-yellow-red with all-red clearance intervals)." />
  <contentHeader name="traffic_light.project" modificationDateTime="2026-09-01T13:30:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1" /></fbd>
      <ld><scaling x="1" y="1" /></ld>
      <sfc><scaling x="1" y="1" /></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes />
    <pous>
      <pou name="PLC_PRG" pouType="program">
        <interface>
          <!-- 内部状态：6 相位状态机 + 各相位定时器 -->
          <localVars>
            <variable name="state">
              <type><INT /></type>
              <initialValue><simpleValue value="0" /></initialValue>
            </variable>
            <variable name="t0">
              <type><derived name="TON" /></type>
            </variable>
            <variable name="t1">
              <type><derived name="TON" /></type>
            </variable>
            <variable name="t2">
              <type><derived name="TON" /></type>
            </variable>
            <variable name="t3">
              <type><derived name="TON" /></type>
            </variable>
            <variable name="t4">
              <type><derived name="TON" /></type>
            </variable>
            <variable name="t5">
              <type><derived name="TON" /></type>
            </variable>
          </localVars>
          <!-- 对外接口-输入：运行使能 -->
          <localVars>
            <variable name="run" address="%QX0.0">
              <type><BOOL /></type>
            </variable>
          </localVars>
          <!-- 对外接口-输出：南北/东西 红黄绿 + 完整周期计数 -->
          <localVars>
            <variable name="ns_g" address="%QX1.0">
              <type><BOOL /></type>
            </variable>
            <variable name="ns_y" address="%QX1.1">
              <type><BOOL /></type>
            </variable>
            <variable name="ns_r" address="%QX1.2">
              <type><BOOL /></type>
            </variable>
            <variable name="ew_g" address="%QX1.3">
              <type><BOOL /></type>
            </variable>
            <variable name="ew_y" address="%QX1.4">
              <type><BOOL /></type>
            </variable>
            <variable name="ew_r" address="%QX1.5">
              <type><BOOL /></type>
            </variable>
            <variable name="cycle_cnt" address="%QW10">
              <type><INT /></type>
              <initialValue><simpleValue value="0" /></initialValue>
            </variable>
            <variable name="prog_id" address="%QW20">
              <type><INT /></type>
              <initialValue><simpleValue value="4" /></initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ---- program identity (scenario = traffic_light) ---- *)
prog_id := 4;

(* ---- phase timers, each armed only in its own state ---- *)
(* phase: 0=NS green 5s, 1=NS yellow 2s, 2=all-red 1s, 3=EW green 5s, 4=EW yellow 2s, 5=all-red 1s *)
t0(IN := run AND (state = 0), PT := T#5S);
t1(IN := run AND (state = 1), PT := T#2S);
t2(IN := run AND (state = 2), PT := T#1S);
t3(IN := run AND (state = 3), PT := T#5S);
t4(IN := run AND (state = 4), PT := T#2S);
t5(IN := run AND (state = 5), PT := T#1S);

(* ---- state transitions ---- *)
IF t0.Q THEN state := 1; END_IF;
IF t1.Q THEN state := 2; END_IF;
IF t2.Q THEN state := 3; END_IF;
IF t3.Q THEN state := 4; END_IF;
IF t4.Q THEN state := 5; END_IF;
IF t5.Q THEN
    state := 0;
    cycle_cnt := cycle_cnt + 1;
END_IF;

(* ---- lamp outputs ---- *)
ns_g := run AND (state = 0);
ns_y := run AND (state = 1);
ns_r := run AND (state &gt;= 2) AND (state &lt;= 5);
ew_g := run AND (state = 3);
ew_y := run AND (state = 4);
ew_r := run AND ((state &gt;= 0) AND (state &lt;= 2) OR (state = 5));</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
</project>
