{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:308sjk:device-ir:0.1-draft",
  "title": "DeviceIR draft; runtime validator enforces graph and AML IO invariants",
  "type": "object",
  "required": ["format", "source", "station", "coordinate_system", "units", "components", "joints", "interfaces", "connections", "io", "pending", "revision", "changes"],
  "properties": {
    "format": {"const": "308sjk.device_ir/0.1-draft"},
    "verification_profile": {"const": "fixed_model_io/1"},
    "source": {"type": "object", "required": ["file", "sha256"]},
    "station": {"type": "string"},
    "coordinate_system": {"const": "right_handed_z_up"},
    "units": {"const": {"length": "m", "angle": "rad", "time": "s", "mass": "kg"}},
    "components": {"type": "array", "items": {"type": "object", "required": ["id", "name", "type", "parent_id", "parameters", "pose", "source", "interfaces"], "properties": {
      "id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "type": {"type": "string", "minLength": 1},
      "parent_id": {"type": ["string", "null"]}, "parameters": {"type": "object"}, "pose": {"$ref": "#/$defs/pose"}, "interfaces": {"type": "array", "items": {"type": "string"}}
    }}},
    "joints": {"type": "array", "items": {"type": "object", "required": ["id", "type", "parent_body", "child_body", "axis", "range", "initial", "parent_anchor_m", "child_anchor_m"], "properties": {
      "type": {"enum": ["slide", "hinge", "ball", "free"]}, "axis": {"$ref": "#/$defs/vec3"}, "parent_anchor_m": {"$ref": "#/$defs/vec3"}, "child_anchor_m": {"$ref": "#/$defs/vec3"}
    }}},
    "assemblies": {"type": "array", "items": {"type": "object", "required": ["id", "parent_component", "child_component", "parent_interface", "child_interface", "placement"], "properties": {
      "placement": {"enum": ["check", "solve"]}, "offset": {"$ref": "#/$defs/pose"}
    }}},
    "interfaces": {"type": "array"}, "connections": {"type": "array"},
    "io": {"type": "array", "items": {"type": "object", "required": ["id", "name", "dir", "type", "address", "component_id", "quantity", "writer", "initial", "source"], "properties": {
      "dir": {"enum": ["input", "output"]}, "type": {"enum": ["BOOL", "INT"]},
      "address": {"type": "string", "pattern": "^%Q(X[0-9]+\\.[0-7]|W[0-9]+)$"},
      "writer": {"enum": ["plc", "simulation", "operator", "fault_harness", null]}
    }}},
    "simulation_requirements": {"type": "object", "required": ["format", "description", "position_tolerance_m", "angle_tolerance_rad", "response_timeout_s", "allowed_simplifications", "checks"], "properties": {
      "format": {"const": "308sjk.simulation_requirements/1"},
      "description": {"type": "string", "minLength": 1},
      "position_tolerance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
      "angle_tolerance_rad": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
      "response_timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
      "allowed_simplifications": {"type": "array", "items": {"type": "string"}},
      "checks": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "object", "required": ["id", "kind", "target", "description"], "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["mechanical_joint", "fixed_mount", "io_binding", "joint_coupling"]}, "target": {"type": "string"}, "description": {"type": "string", "minLength": 1}
      }, "additionalProperties": false}}, "source": {"type": "object"}
    }, "additionalProperties": false},
    "couplings": {"type": "array", "items": {"type": "object", "required": ["id", "leader", "follower", "ratio", "offset"]}},
    "pending": {"type": "array"}, "revision": {"type": "integer", "minimum": 0}, "changes": {"type": "array"}, "facts_sha256": {"type": "string"}
  },
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "pose": {"type": "object", "properties": {"position_m": {"$ref": "#/$defs/vec3"}, "rpy_rad": {"$ref": "#/$defs/vec3"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
