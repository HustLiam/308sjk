{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM declarative simulation test plan v1.0",
  "type": "object", "additionalProperties": false,
  "required": ["version", "task_id", "intent", "runtime", "sampling", "timeout_s", "initial_inputs", "actions", "completion", "cleanup_inputs", "path_checks"],
  "properties": {
    "version": {"const": "1.0"}, "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "intent": {"type": "string", "minLength": 1},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["backend", "startup_timeout_s"], "properties": {"backend": {"const": "mujoco"}, "startup_timeout_s": {"type": "number", "minimum": 1, "maximum": 60}}},
    "sampling": {"type": "object", "additionalProperties": false, "required": ["scope", "period_ms"], "properties": {"scope": {"const": "all_mapped"}, "period_ms": {"type": "number", "minimum": 10, "maximum": 500}}},
    "timeout_s": {"type": "number", "minimum": 1, "maximum": 180},
    "initial_inputs": {"$ref": "#/$defs/values"}, "cleanup_inputs": {"$ref": "#/$defs/values"},
    "actions": {"type": "array", "minItems": 2, "maxItems": 128, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"const": "start_simulation"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "values"], "properties": {"op": {"const": "set"}, "values": {"$ref": "#/$defs/values"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "signal", "value", "restore", "duration_ms"], "properties": {"op": {"const": "pulse"}, "signal": {"type": "string"}, "value": {"type": "boolean"}, "restore": {"type": "boolean"}, "duration_ms": {"type": "number", "minimum": 100, "maximum": 10000}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "seconds"], "properties": {"op": {"const": "wait"}, "seconds": {"type": "number", "minimum": 0, "maximum": 30}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "all", "timeout_s"], "properties": {"op": {"const": "wait_until"}, "all": {"$ref": "#/$defs/conditions"}, "timeout_s": {"type": "number", "minimum": 0.1, "maximum": 180}}}
    ]}},
    "completion": {"type": "object", "additionalProperties": false, "required": ["all", "settle_s"], "properties": {"all": {"$ref": "#/$defs/conditions"}, "settle_s": {"type": "number", "minimum": 0.1, "maximum": 5}}},
    "path_checks": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "desc", "points"], "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "desc": {"type": "string", "minLength": 1},
        "segments": {"type": "object", "additionalProperties": false, "required": ["signals", "tolerance", "when"], "properties": {
          "signals": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "tolerance": {"type": "number", "minimum": 0.01}, "when": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}}
        }},
        "points": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false,
          "required": ["values", "tolerance", "states"], "properties": {
            "values": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer"}},
            "tolerance": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0}},
            "states": {"type": "object", "additionalProperties": {"type": ["boolean", "integer"]}}
          }
        }}
      }
    }}
  },
  "$defs": {
    "values": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["boolean", "integer"]}},
    "conditions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["signal", "equals"], "properties": {"signal": {"type": "string"}, "equals": {"type": ["boolean", "integer"]}}},
      {"type": "object", "additionalProperties": false, "required": ["signal", "target", "tolerance"], "properties": {"signal": {"type": "string"}, "target": {"type": "integer"}, "tolerance": {"type": "number", "minimum": 0}}}
    ]}}
  }
}
