<?xml version='1.0' encoding='utf-8'?>
<CAEXFile xmlns="http://www.dke.de/CAEX" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" SchemaVersion="3.0" FileName="factoryforge_sorting_reference.aml" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <SuperiorStandardVersion>AutomationML 2.10</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="308sjk reference device description" OriginID="308sjk-factoryforge-aml-profile" OriginVersion="0.1-draft" LastWritingDateTime="2026-10-26T00:00:00+08:00" OriginProjectTitle="FactoryForge height sorting reference" OriginProjectID="57273ccde7064c818c507c638f7e92526bc5c436" />
  <InstanceHierarchy Name="FactoryForgeSortingCell" ID="081edd58-0340-5e4a-bafb-a97f00f0d259">
    <Attribute Name="SimulationRequirements">
      <Attribute Name="format" AttributeDataType="xs:string"><Value>308sjk.simulation_requirements/1</Value></Attribute>
      <Attribute Name="description" AttributeDataType="xs:string"><Value>验证推料机构的机械连接、轴向与行程；逐通道验证指令响应、传感反馈、边界及 IO 归属。结果与轨迹保存在任务产物中。</Value></Attribute>
      <Attribute Name="position_tolerance_m" AttributeDataType="xs:double" Unit="m"><Value>0.002</Value></Attribute>
      <Attribute Name="angle_tolerance_rad" AttributeDataType="xs:double" Unit="rad"><Value>0.001</Value></Attribute>
      <Attribute Name="response_timeout_s" AttributeDataType="xs:double" Unit="s"><Value>3</Value></Attribute>
      <Attribute Name="allowed_simplifications">
        <Attribute Name="visual" AttributeDataType="xs:string"><Value>外壳、纹理及电气内部结构可省略；保留接触、行程、通道与检测所需几何。</Value></Attribute>
        <Attribute Name="drive" AttributeDataType="xs:string"><Value>允许使用已明确质量、阻尼、增益与速度的伺服近似；不得以指令值冒充实际反馈。</Value></Attribute>
      </Attribute>
      <Attribute Name="checks">
        <Attribute Name="mechanical_all">
          <Attribute Name="kind" AttributeDataType="xs:string"><Value>mechanical_joint</Value></Attribute>
          <Attribute Name="target" AttributeDataType="xs:string"><Value>*</Value></Attribute>
          <Attribute Name="description" AttributeDataType="xs:string"><Value>逐运动副核对连接两端、初始位姿、实际轴向及全行程合法位姿。</Value></Attribute>
        </Attribute>
        <Attribute Name="io_all">
          <Attribute Name="kind" AttributeDataType="xs:string"><Value>io_binding</Value></Attribute>
          <Attribute Name="target" AttributeDataType="xs:string"><Value>*</Value></Attribute>
          <Attribute Name="description" AttributeDataType="xs:string"><Value>逐通道核对名称、逻辑方向、类型、地址、写入者、物理属性和换算；验证实际响应及反馈阈值。</Value></Attribute>
        </Attribute>
      </Attribute>
    </Attribute>
    <InternalElement Name="sorting_line" ID="95854435-319f-5e5c-a83e-f616e997f0a1" RefBaseSystemUnitPath="FFDeviceClassLib/HeightSortingLine">
      <Description>面向 PLC 顺序、联锁和传感反馈验证的按高度分拣线设备描述。以组件连接、运动约束、驱动响应和 IO 映射为核心，采用功能所需的简化几何，不引用三维资产；软件参考参数不代表实机标定。</Description>
