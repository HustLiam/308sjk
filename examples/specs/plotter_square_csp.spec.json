{
  "task_id": "plotter_square_csp",
  "task_goal": "三轴 CSP 绘图仪在使能后收到画图请求：先抬笔并定位到 (20,20)，落笔后依次经过 (80,20)、(80,80)、(20,80)、(20,20) 闭合为边长60的正方形，随后抬笔至10mm并返回中心(50,50)，最后保持完成灯。",
  "io_list": [
    {
      "name": "run",
      "dir": "input",
      "type": "BOOL",
      "address": "%QX0.0",
      "trigger": true,
      "device": "OperatorPanel run 使能"
    },
    {
      "name": "cmd_reset",
      "dir": "input",
      "type": "BOOL",
      "address": "%QX0.7",
      "device": "OperatorPanel 复位"
    },
    {
      "name": "cmd_draw",
      "dir": "input",
      "type": "BOOL",
      "address": "%QX2.0",
      "trigger": true,
      "device": "OperatorPanel 启动画方"
    },
    {
      "name": "any_moving",
      "dir": "output",
      "type": "BOOL",
      "address": "%QX1.2",
      "device": "任一轴未到位"
    },
    {
      "name": "pen_down",
      "dir": "output",
      "type": "BOOL",
      "address": "%QX2.1",
      "device": "笔接触状态（z<=1）"
    },
    {
      "name": "plot_done",
      "dir": "output",
      "type": "BOOL",
      "address": "%QX2.2",
      "device": "绘图完成"
    },
    {
      "name": "x_cmd",
      "dir": "output",
      "type": "INT",
      "range": [
        0,
        100
      ],
      "device": "X 轴插补位置目标（CSP 上总线）",
      "address": "%QW3"
    },
    {
      "name": "y_cmd",
      "dir": "output",
      "type": "INT",
      "range": [
        0,
        100
      ],
      "device": "Y 轴插补位置目标",
      "address": "%QW4"
    },
    {
      "name": "z_cmd",
      "dir": "output",
      "type": "INT",
      "range": [
        0,
        10
      ],
      "device": "Z 轴位置目标（0 落笔/1 抬笔，龙门场景 z 行程 1m 量程 0..10）",
      "address": "%QW5"
    },
    {
      "name": "x_fb",
      "dir": "input",
      "type": "INT",
      "range": [
        0,
        100
      ],
      "device": "X 位置反馈",
      "address": "%QW0"
    },
    {
      "name": "y_fb",
      "dir": "input",
      "type": "INT",
      "range": [
        0,
        100
      ],
      "device": "Y 位置反馈",
      "address": "%QW1"
    },
    {
      "name": "z_fb",
      "dir": "input",
      "type": "INT",
      "range": [
        0,
        10
      ],
      "device": "Z 位置反馈",
      "address": "%QW2"
    }
  ],
  "constraints": [
    {
      "id": "C1",
      "kind": "interlock",
      "desc": "落笔期间禁止变更定位目标（序列器保证）；完成后抬笔（plot_done=1 时 pen_down=0）"
    }
  ],
  "acceptance": [
    {
      "id": "AC1",
      "desc": "cmd_draw 上升沿后 plot_done 在 120s 内置位（含全序列时限）",
      "type": "event_delay",
      "from": {
        "signal": "cmd_draw",
        "edge": "rising"
      },
      "to": {
        "signal": "plot_done",
        "edge": "rising"
      },
      "op": "<=",
      "value": 120,
      "unit": "s"
    },
    {
      "id": "AC2",
      "desc": "序列终点：笔回中心 (50,50)，Z 抬笔到10mm",
      "type": "region_containment",
      "asset": "gantry",
      "region_center": [
        50,
        50,
        10
      ],
      "tolerance": 2,
      "check_at": "end"
    },
    {
      "id": "AC3",
      "desc": "完成后不得仍落笔（plot_done=1 期间 pen_down=0）",
      "type": "forbidden_state",
      "when": {
        "signal": "plot_done",
        "equals": 1
      },
      "forbid": {
        "signal": "pen_down",
        "equals": 1
      }
    },
    {
      "id": "AC4",
      "desc": "仿真健康：x_fb/y_fb∈[0,100]、z_fb∈[0,10]，无发散",
      "type": "sim_health"
    }
  ],
  "schema_version": "1.0.0-draft.3",
  "prog_id": 4,
  "axes": [
    {
      "axis": "x_axis",
      "type": "linear",
      "stroke": [
        0,
        100
      ],
      "unit": "%",
      "limits": {
        "vmax": 40.0,
        "accel": 80.0
      },
      "defaults": {
        "velocity": 40.0,
        "acceleration": 80.0,
        "deceleration": 80.0
      },
      "poswin": 2.0,
      "io": {
        "fb": "x_fb",
        "cmd": "x_cmd"
      }
    },
    {
      "axis": "y_axis",
      "type": "linear",
      "stroke": [
        0,
        100
      ],
      "unit": "%",
      "limits": {
        "vmax": 40.0,
        "accel": 80.0
      },
      "defaults": {
        "velocity": 40.0,
        "acceleration": 80.0,
        "deceleration": 80.0
      },
      "poswin": 2.0,
      "io": {
        "fb": "y_fb",
        "cmd": "y_cmd"
      }
    },
    {
      "axis": "z_axis",
      "type": "linear",
      "stroke": [
        0,
        10
      ],
      "unit": "mm",
      "limits": {
        "vmax": 20.0,
        "accel": 60.0
      },
      "defaults": {
        "velocity": 20.0,
        "acceleration": 60.0,
        "deceleration": 60.0
      },
      "poswin": 1.0,
      "io": {
        "fb": "z_fb",
        "cmd": "z_cmd"
      }
    }
  ]
}
