#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    custom string simio:sceneId = "conveyor_sort_001"

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def "Looks"
    {
        def Material "GroundMat" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.72
            float physics:restitution = 0.1
            float physics:staticFriction = 0.8
        }

        def Material "BeltMat" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0.1
            float physics:staticFriction = 1.2
        }
    }

    def Xform "Ground"
    {
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Plate" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/GroundMat>
            color3f[] primvars:displayColor = [(0.32, 0.33, 0.35)]
            double size = 1
            float3 xformOp:scale = (20, 20, 0.1)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "belt_1"
    {
        custom string simio:assetType = "conveyor_belt"
        custom float simio:maxSpeed = 0.8
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "belt" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/BeltMat>
            color3f[] primvars:displayColor = [(0.18, 0.18, 0.2)]
            double size = 1
            float3 xformOp:scale = (3, 0.6, 0.1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "rail_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.55, 0.55, 0.58)]
            double size = 1
            float3 xformOp:scale = (3, 0.02, 0.04)
            double3 xformOp:translate = (0, -0.29, 0.07)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "rail_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.55, 0.55, 0.58)]
            double size = 1
            float3 xformOp:scale = (3, 0.02, 0.04)
            double3 xformOp:translate = (0, 0.29, 0.07)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "cyl_1"
    {
        custom string simio:assetType = "pneumatic_cylinder"
        custom float simio:extendSpeed = 1
        custom float simio:retractSpeed = 1
        custom float simio:stroke = 0.4
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (2, -0.35, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "mesh" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.3, 0.3, 0.34)]
                double size = 1
                float3 xformOp:scale = (0.08, 0.08, 0.08)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "rod" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1
            double3 xformOp:translate = (-0, -0.18, -0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "mesh" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.75, 0.75, 0.78)]
                double size = 1
                float3 xformOp:scale = (0.02, 0.44, 0.02)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def PhysicsPrismaticJoint "joint" (
            prepend apiSchemas = ["PhysicsLimitAPI:transY", "PhysicsDriveAPI:transY"]
        )
        {
            float drive:transY:physics:damping = 150
            float drive:transY:physics:maxForce = 500
            float drive:transY:physics:stiffness = 5000
            float drive:transY:physics:targetPosition = 0
            uniform token drive:transY:physics:type = "position"
            float limit:transY:physics:high = 0.4
            float limit:transY:physics:low = 0
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/cyl_1/base>
            rel physics:body1 = </World/cyl_1/rod>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0.18, 0)
        }
    }

    def Xform "pe_1"
    {
        custom string simio:assetType = "photoelectric_sensor"
        custom float3 simio:beamDirection = (0, 1, 0)
        custom float simio:beamLength = 0.5
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (1.8, -0.25, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "housing"
        {
            color3f[] primvars:displayColor = [(0.9, 0.75, 0.1)]
            double size = 1
            float3 xformOp:scale = (0.04, 0.04, 0.04)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "chute_1"
    {
        custom string simio:assetType = "bin_chute"
        custom float3 simio:regionCenter = (0, 0, 0.25)
        custom float3 simio:regionSize = (0.36, 0.36, 0.5)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (2, 0.75, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "floor" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.45, 0.45, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.4, 0.4, 0.02)
            double3 xformOp:translate = (0, 0, 0.01)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.45, 0.45, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.4, 0.02, 0.5)
            double3 xformOp:translate = (0, 0.19, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.45, 0.45, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.4, 0.02, 0.5)
            double3 xformOp:translate = (0, -0.19, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_2" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.45, 0.45, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.02, 0.4, 0.5)
            double3 xformOp:translate = (0.19, 0, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_3" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.45, 0.45, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.02, 0.4, 0.5)
            double3 xformOp:translate = (-0.19, 0, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "box_a"
    {
        custom string simio:assetType = "rigid_box"
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.62)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Xform "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.5
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "mesh" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.8509804, 0.3254902, 0.30980393)]
                double size = 1
                float3 xformOp:scale = (0.1, 0.1, 0.1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }
}

