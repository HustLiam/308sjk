{
  "task_id": "plotter_square_csp",
  "task_goal": "三轴绘图机在 XY 平面绘制边长 60（坐标区间 20..80）的正方形并闭合：抬笔定位起点 → 落笔沿四边 → 抬笔回中心。CSP 形态：PLC 输出插补位置目标（%QW0-2），驱动器（仿真侧/真机 CSP 模式）闭位置环；Z 0=落笔接触、10=抬笔安全高度。本版按 runs/latest 龙门场景接线（x_cmd/y_cmd/z_cmd %QW3-5，反馈 %QW0-2）",
  "io_list": [
    {
      "name": "run",
      "dir": "input",
      "type": "BOOL",
      "device": "OperatorPanel run 使能"
    },
    {
      "name": "cmd_reset",
      "dir": "input",
      "type": "BOOL",
      "device": "OperatorPanel 复位"
    },
    {
      "name": "cmd_draw",
      "dir": "input",
      "type": "BOOL",
      "device": "OperatorPanel 启动画方"
    },
    {
      "name": "any_moving",
      "dir": "output",
      "type": "BOOL",
      "device": "任一轴未到位"
    },
    {
      "name": "pen_down",
      "dir": "output",
      "type": "BOOL",
      "device": "笔接触状态（z<=1）"
    },
    {
      "name": "plot_done",
      "dir": "output",
      "type": "BOOL",
      "device": "绘图完成"
    },
    {
      "name": "x_cmd",
      "dir": "output",
      "type": "INT",
      "range": [
        0,
        100
      ],
      "device": "X 轴插补位置目标（CSP 上总线）"
    },
    {
      "name": "y_cmd",
      "dir": "output",
      "type": "INT",
      "range": [
        0,
        100
      ],
      "device": "Y 轴插补位置目标"
    },
    {
      "name": "z_cmd",
      "dir": "output",
      "type": "INT",
      "range": [
        0,
        10
      ],
      "device": "Z 轴位置目标（0 落笔/1 抬笔，龙门场景 z 行程 1m 量程 0..10）"
    },
    {
      "name": "x_fb",
      "dir": "input",
      "type": "INT",
      "range": [
        0,
        100
      ],
      "device": "X 位置反馈"
    },
    {
      "name": "y_fb",
      "dir": "input",
      "type": "INT",
      "range": [
        0,
        100
      ],
      "device": "Y 位置反馈"
    },
    {
      "name": "z_fb",
      "dir": "input",
      "type": "INT",
      "range": [
        0,
        10
      ],
      "device": "Z 位置反馈"
    }
  ],
  "constraints": [
    {
      "id": "C1",
      "kind": "interlock",
      "desc": "落笔期间禁止变更定位目标（序列器保证）；完成后抬笔（plot_done=1 时 pen_down=0）"
    }
  ],
  "acceptance": [
    {
      "id": "AC1",
      "desc": "cmd_draw 上升沿后 plot_done 在 120s 内置位（含全序列时限）",
      "type": "event_delay",
      "from": {
        "signal": "cmd_draw",
        "edge": "rising"
      },
      "to": {
        "signal": "plot_done",
        "edge": "rising"
      },
      "op": "<=",
      "value": 120,
      "unit": "s"
    },
    {
      "id": "AC2",
      "desc": "序列终点：笔回中心 (50,50) 并抬笔（z_fb>=1）",
      "type": "region_containment",
      "asset": "gantry",
      "region_center": [
        50,
        50,
        1
      ],
      "tolerance": 2,
      "check_at": "end"
    },
    {
      "id": "AC3",
      "desc": "完成后不得仍落笔（plot_done=1 期间 pen_down=0）",
      "type": "forbidden_state",
      "when": {
        "signal": "plot_done",
        "equals": 1
      },
      "forbid": {
        "signal": "pen_down",
        "equals": 1
      }
    },
    {
      "id": "AC4",
      "desc": "仿真健康：x_fb/y_fb∈[0,100]、z_fb∈[0,10]，无发散",
      "type": "sim_health"
    }
  ],
  "schema_version": "1.0.0-draft.3"
}