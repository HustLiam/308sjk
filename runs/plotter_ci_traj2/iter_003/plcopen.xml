      <pou name="INTERP" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire"><type><BOOL /></type></variable>
            <variable name="pos_target"><type><INT /></type></variable>
            <variable name="pos_in"><type><INT /></type></variable>
            <variable name="VMAX"><type><REAL /></type></variable>
            <variable name="ACCEL"><type><REAL /></type></variable>
            <variable name="POSWIN"><type><REAL /></type></variable>
          </inputVars>
          <outputVars>
            <variable name="Setpoint"><type><INT /></type></variable>
            <variable name="Busy"><type><BOOL /></type></variable>
            <variable name="Done"><type><BOOL /></type></variable>
          </outputVars>
          <localVars>
            <variable name="tgt"><type><REAL /></type></variable>
            <variable name="pos"><type><REAL /></type></variable>
            <variable name="vel"><type><REAL /></type></variable>
            <variable name="dist"><type><REAL /></type></variable>
            <variable name="stop_d"><type><REAL /></type></variable>
            <variable name="edge_ir"><type><BOOL /></type></variable>
            <variable name="started"><type><BOOL /></type></variable>
          </localVars>
        </interface>
        <body><ST><html:p>
IF fire AND NOT edge_ir THEN
    tgt := INT_TO_REAL(pos_target);
    pos := INT_TO_REAL(pos_in);
    vel := 0.0;
    Busy := TRUE;
    Done := FALSE;
    started := TRUE;
END_IF;
edge_ir := fire;
(* 连续跟踪：fire 电平保持期间目标变化即起新轨迹 *)
IF (NOT Busy) AND fire AND (ABS(INT_TO_REAL(pos_target) - tgt) &gt; 0.499) THEN
    tgt := INT_TO_REAL(pos_target);
    pos := INT_TO_REAL(pos_in);
    vel := 0.0;
    Busy := TRUE;
    Done := FALSE;
END_IF;
IF started THEN
    IF Busy THEN
        dist := tgt - pos;
        stop_d := (vel * vel) / (2.0 * ACCEL);
        IF ABS(dist) &lt;= stop_d THEN
            IF dist &gt;= 0.0 THEN
                vel := MAX(0.0, vel - ACCEL * 0.02);
            ELSE
                vel := MIN(0.0, vel + ACCEL * 0.02);
            END_IF;
            IF (vel = 0.0) AND (ABS(dist) &lt;= POSWIN) THEN
                pos := tgt;
                Busy := FALSE;
                Done := TRUE;
            END_IF;
        ELSE
            IF dist &gt; 0.0 THEN
                vel := MIN(VMAX, vel + ACCEL * 0.02);
            ELSE
                vel := MAX(-VMAX, vel - ACCEL * 0.02);
            END_IF;
        END_IF;
    END_IF;
    pos := pos + vel * 0.02;
    Setpoint := REAL_TO_INT(pos);
ELSE
    Setpoint := pos_in;
END_IF;
        </html:p></ST></body>
      </pou>

      <pou name="DRIVE402" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="cw"><type><WORD /></type></variable>
            <variable name="Setpoint"><type><INT /></type></variable>
            <variable name="pos_fb"><type><INT /></type></variable>
          </inputVars>
          <outputVars>
            <variable name="sw"><type><WORD /></type></variable>
            <variable name="v_cmd"><type><INT /></type></variable>
          </outputVars>
          <localVars>
            <variable name="state"><type><INT /></type><initialValue><simpleValue value="1" /></initialValue></variable>
            <variable name="cmd"><type><WORD /></type></variable>
            <variable name="v_out"><type><REAL /></type></variable>
            <variable name="v_ff"><type><REAL /></type></variable>
            <variable name="pos_err"><type><REAL /></type></variable>
            <variable name="sp_prev"><type><INT /></type></variable>
          </localVars>
          <localVars constant="true">
            <variable name="SCAN_T"><type><REAL /></type><initialValue><simpleValue value="0.02" /></initialValue></variable>
            <variable name="KP"><type><REAL /></type><initialValue><simpleValue value="8.0" /></initialValue></variable>
          </localVars>
        </interface>
        <body><ST><html:p>
(* state: 1=SOD 2=RTSO 3=SO 4=OE 5=QSA 6=FRA 7=FA *)
cmd := cw AND 16#000F;

IF (state = 7) AND ((cw AND 16#0080) &lt;&gt; 0) THEN
    state := 1;
END_IF;

CASE state OF
    1: IF cmd = 16#06 THEN state := 2; END_IF;
    2: IF cmd = 16#07 THEN state := 3;
       ELSIF cmd = 16#0F THEN state := 4;
       ELSIF cmd = 16#00 THEN state := 1;
       END_IF;
    3: IF cmd = 16#0F THEN state := 4;
       ELSIF cmd = 16#06 THEN state := 2;
       ELSIF cmd = 16#00 THEN state := 1;
       ELSIF cmd = 16#02 THEN state := 5;
       END_IF;
    4: IF cmd = 16#07 THEN state := 3;
       ELSIF cmd = 16#06 THEN state := 2;
       ELSIF cmd = 16#00 THEN state := 1;
       ELSIF cmd = 16#02 THEN state := 5;
       END_IF;
    5: IF v_out = 0.0 THEN
           IF cmd = 16#0F THEN state := 4;
           ELSIF cmd = 16#06 THEN state := 2;
           ELSIF cmd = 16#00 THEN state := 1;
           END_IF;
       END_IF;
    6: IF v_out = 0.0 THEN state := 7; END_IF;
    ELSE
       state := state;
END_CASE;

(* 位置环：P 控制 + 设定值差分前馈 *)
IF (state &gt;= 4) AND (state &lt;= 6) THEN
    v_ff := INT_TO_REAL(Setpoint - sp_prev) / SCAN_T;
    pos_err := INT_TO_REAL(Setpoint) - INT_TO_REAL(pos_fb);
    v_out := v_ff + KP * pos_err;
    IF v_out &gt; 120.0 THEN v_out := 120.0; END_IF;
    IF v_out &lt; -120.0 THEN v_out := -120.0; END_IF;
    IF (v_ff = 0.0) AND (ABS(pos_err) &lt;= 1.5) THEN
        v_out := 0.0;
    END_IF;
ELSE
    (* 非使能/快停态：速度指令立即归零 —— 满足 AC5/AC6 禁止态 *)
    v_out := 0.0;
    v_ff := 0.0;
    pos_err := 0.0;
END_IF;

sp_prev := Setpoint;
v_cmd := REAL_TO_INT(v_out);

sw := 16#0000;
CASE state OF
    1: sw := 16#0040;
    2: sw := 16#0031;
    3: sw := 16#0033;
    4: sw := 16#0037;
    5: sw := 16#0014;
    6: sw := 16#0011;
    7: sw := 16#0018;
    ELSE
       sw := sw;
END_CASE;
IF state = 4 THEN
    IF (ABS(pos_err) &lt;= 2.0) AND (v_ff = 0.0) THEN
        sw := sw OR 16#0400;
    END_IF;
END_IF;
        </html:p></ST></body>
      </pou>

      <pou name="MC_POWER" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable"><type><BOOL /></type></variable>
            <variable name="sw"><type><WORD /></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="cw"><type><WORD /></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Status"><type><BOOL /></type></variable>
          </outputVars>
          <localVars>
            <variable name="pstep"><type><INT /></type><initialValue><simpleValue value="0" /></initialValue></variable>
          </localVars>
        </interface>
        <body><ST><html:p>
IF Enable AND (pstep = 4) AND ((sw AND 16#0004) = 0) AND ((sw AND 16#0008) = 0) THEN
    pstep := 0;
END_IF;
IF Enable THEN
    CASE pstep OF
        0: cw := (cw AND 16#00F0) OR 16#0006;  pstep := 1;
        1: IF (sw AND 16#0001) &lt;&gt; 0 THEN cw := (cw AND 16#00F0) OR 16#0007; pstep := 2; END_IF;
        2: IF (sw AND 16#0002) &lt;&gt; 0 THEN cw := (cw AND 16#00F0) OR 16#000F; pstep := 3; END_IF;
        3: IF (sw AND 16#0004) &lt;&gt; 0 THEN pstep := 4; END_IF;
        ELSE
           pstep := 0;
    END_CASE;
ELSE
    (* 未使能期间持续 shutdown，驱动器保持 RTSO *)
    cw := (cw AND 16#00F0) OR 16#0006;
    pstep := 0;
END_IF;
Status := (sw AND 16#0004) &lt;&gt; 0;
        </html:p></ST></body>
      </pou>

      <pou name="MC_RESET" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire"><type><BOOL /></type></variable>
            <variable name="sw"><type><WORD /></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="cw"><type><WORD /></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Done"><type><BOOL /></type></variable>
          </outputVars>
          <localVars>
            <variable name="busy"><type><BOOL /></type></variable>
            <variable name="edge_rs"><type><BOOL /></type></variable>
          </localVars>
        </interface>
        <body><ST><html:p>
IF fire AND NOT edge_rs THEN
    busy := TRUE;
END_IF;
edge_rs := fire;
IF busy THEN
    IF (sw AND 16#0008) &lt;&gt; 0 THEN
        cw := cw OR 16#0080;
    ELSE
        cw := cw AND 16#FF7F;
        busy := FALSE;
    END_IF;
END_IF;
Done := (NOT busy) AND ((sw AND 16#0008) = 0) AND (NOT fire);
        </html:p></ST></body>
      </pou>

      <pou name="MC_STOP" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire"><type><BOOL /></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="cw"><type><WORD /></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Done"><type><BOOL /></type></variable>
          </outputVars>
        </interface>
        <body><ST><html:p>
IF fire THEN
    cw := (cw AND 16#00F0) OR 16#0002;
    Done := FALSE;
ELSE
    Done := TRUE;
END_IF;
        </html:p></ST></body>
      </pou>

      <pou name="MC_MOVEABSOLUTE" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire"><type><BOOL /></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="interp_exe"><type><BOOL /></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Done"><type><BOOL /></type></variable>
            <variable name="Busy"><type><BOOL /></type></variable>
          </outputVars>
          <localVars>
            <variable name="edge_ma"><type><BOOL /></type></variable>
          </localVars>
        </interface>
        <body><ST><html:p>
IF fire AND NOT edge_ma THEN
    interp_exe := TRUE;
END_IF;
edge_ma := fire;
Done := NOT interp_exe;
Busy := interp_exe;
        </html:p></ST></body>
      </pou>

      <pou name="MC_MOVEJOG" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="JogForward"><type><BOOL /></type></variable>
            <variable name="JogBackward"><type><BOOL /></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="jog_pos"><type><INT /></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Busy"><type><BOOL /></type></variable>
          </outputVars>
        </interface>
        <body><ST><html:p>
IF JogForward AND (jog_pos &lt; 97) THEN
    jog_pos := jog_pos + 1;
ELSIF JogBackward AND (jog_pos &gt; 3) THEN
    jog_pos := jog_pos - 1;
END_IF;
Busy := JogForward OR JogBackward;
        </html:p></ST></body>
      </pou>

      <pou name="MC_HOME" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire"><type><BOOL /></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="home_exe"><type><BOOL /></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Done"><type><BOOL /></type></variable>
          </outputVars>
          <localVars>
            <variable name="edge_hm"><type><BOOL /></type></variable>
          </localVars>
        </interface>
        <body><ST><html:p>
IF fire AND NOT edge_hm THEN
    home_exe := TRUE;
END_IF;
edge_hm := fire;
Done := NOT home_exe;
        </html:p></ST></body>
      </pou>

      <pou name="PLC_PRG" pouType="program">
        <interface>
          <localVars>
            <variable name="x_cw"><type><WORD /></type></variable>
            <variable name="y_cw"><type><WORD /></type></variable>
            <variable name="z_cw"><type><WORD /></type></variable>
            <variable name="x_sw_w"><type><WORD /></type></variable>
            <variable name="y_sw_w"><type><WORD /></type></variable>
            <variable name="z_sw_w"><type><WORD /></type></variable>
            <variable name="x_interp"><type><INT /></type></variable>
            <variable name="y_interp"><type><INT /></type></variable>
            <variable name="z_interp"><type><INT /></type></variable>
            <variable name="x_jog_pos"><type><INT /></type><initialValue><simpleValue value="50" /></initialValue></variable>
            <variable name="ptx"><type><INT /></type></variable>
            <variable name="pty"><type><INT /></type></variable>
            <variable name="ptz"><type><INT /></type></variable>
            <variable name="pl_step"><type><INT /></type><initialValue><simpleValue value="0" /></initialValue></variable>
            <variable name="pl_tx"><type><INT /></type></variable>
            <variable name="pl_ty"><type><INT /></type></variable>
            <variable name="pl_tz"><type><INT /></type></variable>
            <variable name="seg"><type><INT /></type></variable>
            <variable name="ang"><type><REAL /></type></variable>
            <variable name="go_x_exe"><type><BOOL /></type></variable>
            <variable name="go_y_exe"><type><BOOL /></type></variable>
            <variable name="go_z_exe"><type><BOOL /></type></variable>
            <variable name="hm_x_exe"><type><BOOL /></type></variable>
            <variable name="hm_y_exe"><type><BOOL /></type></variable>
            <variable name="hm_z_exe"><type><BOOL /></type></variable>
            <variable name="draw_prev"><type><BOOL /></type></variable>
            <variable name="rs_prev"><type><BOOL /></type></variable>
            <variable name="draw_rise"><type><BOOL /></type></variable>
            <variable name="rs_rise"><type><BOOL /></type></variable>
            <variable name="abort_latch"><type><BOOL /></type></variable>
            <variable name="go_ok"><type><BOOL /></type></variable>
            <variable name="jog_ok"><type><BOOL /></type></variable>
            <variable name="pen_cmd"><type><BOOL /></type></variable>
            <variable name="dv_x" typeName="DRIVE402"><type><derived name="DRIVE402" /></type></variable>
            <variable name="dv_y" typeName="DRIVE402"><type><derived name="DRIVE402" /></type></variable>
            <variable name="dv_z" typeName="DRIVE402"><type><derived name="DRIVE402" /></type></variable>
            <variable name="pwr_x" typeName="MC_POWER"><type><derived name="MC_POWER" /></type></variable>
            <variable name="pwr_y" typeName="MC_POWER"><type><derived name="MC_POWER" /></type></variable>
            <variable name="pwr_z" typeName="MC_POWER"><type><derived name="MC_POWER" /></type></variable>
            <variable name="rs_x" typeName="MC_RESET"><type><derived name="MC_RESET" /></type></variable>
            <variable name="st_x" typeName="MC_STOP"><type><derived name="MC_STOP" /></type></variable>
            <variable name="st_y" typeName="MC_STOP"><type><derived name="MC_STOP" /></type></variable>
            <variable name="st_z" typeName="MC_STOP"><type><derived name="MC_STOP" /></type></variable>
            <variable name="go_x" typeName="MC_MOVEABSOLUTE"><type><derived name="MC_MOVEABSOLUTE" /></type></variable>
            <variable name="go_y" typeName="MC_MOVEABSOLUTE"><type><derived name="MC_MOVEABSOLUTE" /></type></variable>
            <variable name="go_z" typeName="MC_MOVEABSOLUTE"><type><derived name="MC_MOVEABSOLUTE" /></type></variable>
            <variable name="hm_x" typeName="MC_HOME"><type><derived name="MC_HOME" /></type></variable>
            <variable name="hm_y" typeName="MC_HOME"><type><derived name="MC_HOME" /></type></variable>
            <variable name="hm_z" typeName="MC_HOME"><type><derived name="MC_HOME" /></type></variable>
            <variable name="jg_x" typeName="MC_MOVEJOG"><type><derived name="MC_MOVEJOG" /></type></variable>
            <variable name="ix_x" typeName="INTERP"><type><derived name="INTERP" /></type></variable>
            <variable name="ix_y" typeName="INTERP"><type><derived name="INTERP" /></type></variable>
            <variable name="ix_z" typeName="INTERP"><type><derived name="INTERP" /></type></variable>
          </localVars>
          <localVars address="true">
            <variable name="run" address="%QX0.0"><type><BOOL /></type></variable>
            <variable name="cmd_home" address="%QX0.1"><type><BOOL /></type></variable>
            <variable name="cmd_go" address="%QX0.2"><type><BOOL /></type></variable>
            <variable name="jog_fwd" address="%QX0.3"><type><BOOL /></type></variable>
            <variable name="jog_rev" address="%QX0.4"><type><BOOL /></type></variable>
            <variable name="quickstop" address="%QX0.5"><type><BOOL /></type></variable>
            <variable name="cmd_reset" address="%QX0.7"><type><BOOL /></type></variable>
            <variable name="cmd_draw" address="%QX2.0"><type><BOOL /></type></variable>
            <variable name="all_oe" address="%QX1.0"><type><BOOL /></type></variable>
            <variable name="move_done" address="%QX1.1"><type><BOOL /></type></variable>
            <variable name="any_moving" address="%QX1.2"><type><BOOL /></type></variable>
            <variable name="fault_any" address="%QX1.3"><type><BOOL /></type></variable>
            <variable name="pen_down" address="%QX2.1"><type><BOOL /></type></variable>
            <variable name="plot_done" address="%QX2.2"><type><BOOL /></type></variable>
            <variable name="x_fb" address="%QW0"><type><INT /></type></variable>
            <variable name="y_fb" address="%QW1"><type><INT /></type></variable>
            <variable name="z_fb" address="%QW2"><type><INT /></type></variable>
            <variable name="x_sp" address="%QW10"><type><INT /></type></variable>
            <variable name="y_sp" address="%QW11"><type><INT /></type></variable>
            <variable name="z_sp" address="%QW12"><type><INT /></type></variable>
            <variable name="x_sw" address="%QW6"><type><INT /></type></variable>
            <variable name="y_sw" address="%QW7"><type><INT /></type></variable>
            <variable name="z_sw" address="%QW8"><type><INT /></type></variable>
            <variable name="x_v" address="%QW13"><type><INT /></type></variable>
            <variable name="y_v" address="%QW14"><type><INT /></type></variable>
            <variable name="z_v" address="%QW15"><type><INT /></type></variable>
            <variable name="prog_id" address="%QW20"><type><INT /></type><initialValue><simpleValue value="3" /></initialValue></variable>
          </localVars>
        </interface>
        <body><ST><html:p>
(* ---- program identity ---- *)
prog_id := 3;

(* ---- 边沿检测 ---- *)
draw_rise := cmd_draw AND NOT draw_prev;
draw_prev := cmd_draw;
rs_rise := cmd_reset AND NOT rs_prev;
rs_prev := cmd_reset;

(* ---- 采样驱动器状态 ---- *)
x_sw_w := dv_x.sw;
y_sw_w := dv_y.sw;
z_sw_w := dv_z.sw;
x_sw := WORD_TO_INT(x_sw_w);
y_sw := WORD_TO_INT(y_sw_w);
z_sw := WORD_TO_INT(z_sw_w);
fault_any := ((x_sw_w AND 16#0008) &lt;&gt; 0) OR ((y_sw_w AND 16#0008) &lt;&gt; 0) OR ((z_sw_w AND 16#0008) &lt;&gt; 0);

(* ---- 使能 / 复位 / 快停（快停优先级最高） ---- *)
pwr_x(Enable := run AND NOT quickstop, cw := x_cw, sw := x_sw_w);
pwr_y(Enable := run AND NOT quickstop, cw := y_cw, sw := y_sw_w);
pwr_z(Enable := run AND NOT quickstop, cw := z_cw, sw := z_sw_w);
rs_x(fire := cmd_reset, cw := x_cw, sw := x_sw_w);
st_x(fire := quickstop, cw := x_cw);
st_y(fire := quickstop, cw := y_cw);
st_z(fire := quickstop, cw := z_cw);

all_oe := pwr_x.Status AND pwr_y.Status AND pwr_z.Status;

(* ---- 笔态：上电/急停/故障/未使能/静止且无落笔命令时绝不报触纸 —— 段[1]/AC4
        （初始 z_fb=0 但系统未就绪，pen_down 必须为 FALSE） *)
pen_cmd := run AND all_oe AND (NOT quickstop) AND (NOT fault_any)
           AND (NOT go_x_exe) AND (NOT go_y_exe) AND (NOT go_z_exe)
           AND (NOT hm_x_exe) AND (NOT hm_y_exe) AND (NOT hm_z_exe)
           AND ((NOT jg_x.Busy));
pen_down := ((pl_step &gt;= 3) AND (pl_step &lt;= 27) AND run AND all_oe AND (NOT quickstop) AND (NOT fault_any))
            OR (pen_cmd AND (z_sp &lt;= 2) AND (pl_step = 0))
           ) AND (z_fb &lt;= 2);
pen_down := (z_cmd_down AND (z_fb &lt;= 2)) OR FALSE;
        </html:p></ST></body>
      </pou>

    </pous>
