  "constraints": [
    {
      "id": "C1",
      "kind": "timing",
      "desc": "启动握手：panel_start上升沿且panel_estop_ok为真、无故障锁存时，置conveyor_run=1并点亮panel_green/stack_green；从Start上升沿到conveyor_run上升沿不超过0.5s。"
    },
    {
      "id": "C2",
      "kind": "timing",
      "desc": "供料节拍：运行中按panel_delay_ms设定的毫秒延时周期性给emitter_emit一个上升沿请求单件供料，延时值取自panel_delay_ms（300~1800ms）。"
    },
    {
      "id": "C3",
      "kind": "timing",
      "desc": "推料时序：高件判定（sensor_high_detect触发且sensor_low_detect未触发）后置pusher_extend=1，等待pusher_extended实际到位；保持panel_delay_ms延时后置pusher_extend=0，等待pusher_retracted实际到位，完成一次推料循环。"
    },
    {
      "id": "C4",
      "kind": "interlock",
      "desc": "急停联锁：panel_estop_ok为假（NC回路断开）期间，conveyor_run、emitter_emit、pusher_extend全部强制为0，立即停止，并锁存急停状态禁止自动重启。"
    },
    {
      "id": "C5",
      "kind": "interlock",
      "desc": "复位门控：急停释放（panel_estop_ok恢复为真）后，必须由panel_reset上升沿清除急停锁存，之后panel_start方可重新启动；未复位前禁止启动。"
    },
    {
      "id": "C6",
      "kind": "interlock",
      "desc": "故障联锁：conveyor_fault或pusher_fault为真期间，停止conveyor_run、emitter_emit、pusher_extend并点亮panel_red报警；故障条件消失且重新使能后可直接重新启动。"
    },
    {
      "id": "C7",
      "kind": "exception",
      "desc": "卡缸/输送故障处理：pusher_fault有效期间受控停止推料并中止当前分拣序列；conveyor_fault有效期间停止输送；异常条件消失且重新使能后可直接重新启动，无需额外复位命令。"
    },
    {
      "id": "C8",
      "kind": "interlock",
      "desc": "推料安全：pusher_extend=1期间不得同时要求反向动作；仅在pusher_retracted为真（q<=0.01m）时才允许下一次伸出，避免机构冲突。"
    }
  ],
  "acceptance": [
    {
      "id": "AC1",
      "desc": "启动后输送带运行：panel_start上升沿到conveyor_run上升沿的响应不超过0.5s。",
      "type": "event_delay",
      "from": {
        "signal": "panel_start",
        "edge": "rising"
      },
      "to": {
        "signal": "conveyor_run",
        "edge": "rising"
      },
      "op": "<=",
      "value": 0.5,
      "unit": "s"
    },
    {
      "id": "AC2",
      "desc": "高件分流：sensor_high_detect触发后推料机构伸出，pusher_extend上升沿到pusher_extended上升沿不超过2.0s（含伺服滞后与通信延迟裕量）。",
      "type": "event_delay",
      "from": {
        "signal": "pusher_extend",
        "edge": "rising"
      },
      "to": {
        "signal": "pusher_extended",
        "edge": "rising"
      },
      "op": "<=",
      "value": 2.0,
      "unit": "s"
    },
    {
      "id": "AC3",
      "desc": "推料回收：pusher_extend下降沿到pusher_retracted上升沿不超过2.0s。",
      "type": "event_delay",
      "from": {
        "signal": "pusher_extend",
        "edge": "falling"
      },
      "to": {
        "signal": "pusher_retracted",
        "edge": "rising"
      },
      "op": "<=",
      "value": 2.0,
      "unit": "s"
    },
    {
      "id": "AC4",
      "desc": "急停安全：panel_estop_ok为假期间禁止输送带运行。",
      "type": "forbidden_state",
      "when": {
        "signal": "panel_estop_ok",
        "equals": false
      },
      "forbid": {
        "signal": "conveyor_run",
        "equals": true
      }
    },
    {
      "id": "AC5",
      "desc": "急停安全：panel_estop_ok为假期间禁止推料伸出。",
      "type": "forbidden_state",
      "when": {
        "signal": "panel_estop_ok",
        "equals": false
      },
      "forbid": {
        "signal": "pusher_extend",
        "equals": true
      }
    },
    {
      "id": "AC6",
      "desc": "输送故障安全：conveyor_fault为真期间禁止输送带运行。",
      "type": "forbidden_state",
      "when": {
        "signal": "conveyor_fault",
        "equals": true
      },
      "forbid": {
        "signal": "conveyor_run",
        "equals": true
      }
    },
    {
      "id": "AC7",
      "desc": "推料故障安全：pusher_fault为真期间禁止推料伸出。",
      "type": "forbidden_state",
      "when": {
        "signal": "pusher_fault",
        "equals": true
      },
      "forbid": {
        "signal": "pusher_extend",
        "equals": true
      }
    },
    {
      "id": "AC8",
      "desc": "仿真健康：本轮从启动到完成无发散、无行程越界，机构与出口计数行为一致。",
      "type": "sim_health"
    }
  ],
