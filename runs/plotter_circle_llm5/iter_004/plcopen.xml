      <pou name="DRIVE402" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="state"><type><INT/></type><initialValue><simpleValue value="1"/></initialValue></variable>
            <variable name="v_out"><type><REAL/></type><initialValue><simpleValue value="0.0"/></initialValue></variable>
            <variable name="v_ff"><type><REAL/></type></variable>
            <variable name="pos_err"><type><REAL/></type><initialValue><simpleValue value="0.0"/></initialValue></variable>
            <variable name="sp_prev"><type><INT/></type><initialValue><simpleValue value="0"/></initialValue></variable>
            <variable name="cmd"><type><WORD/></type></variable>
          </localVars>
          <localVars constant="true">
            <variable name="SCAN_T"><type><REAL/></type><initialValue><simpleValue value="0.02"/></initialValue></variable>
            <variable name="KP"><type><REAL/></type><initialValue><simpleValue value="6.0"/></initialValue></variable>
            <variable name="QS_DECEL"><type><REAL/></type><initialValue><simpleValue value="120.0"/></initialValue></variable>
          </localVars>
          <inputVars>
            <variable name="cw"><type><WORD/></type></variable>
            <variable name="Setpoint"><type><INT/></type></variable>
            <variable name="pos_fb"><type><INT/></type></variable>
          </inputVars>
          <outputVars>
            <variable name="v_cmd"><type><INT/></type></variable>
            <variable name="sw"><type><WORD/></type></variable>
          </outputVars>
        </interface>
        <body><ST><xhtml:p xmlns:xhtml="http://www.w3.org/1999/xhtml"><![CDATA[
cmd := cw AND 16#000F;

IF state = 7 AND (cw AND 16#0080) <> 0 THEN
    state := 1;
END_IF;

CASE state OF
    1: IF cmd = 16#06 THEN state := 2; END_IF;
    2: IF cmd = 16#07 THEN state := 3;
       ELSIF cmd = 16#0F THEN state := 4;
       ELSIF cmd = 16#00 THEN state := 1;
       END_IF;
    3: IF cmd = 16#0F THEN state := 4;
       ELSIF cmd = 16#06 THEN state := 2;
       ELSIF cmd = 16#00 THEN state := 1;
       ELSIF cmd = 16#02 THEN state := 5;
       END_IF;
    4: IF cmd = 16#07 THEN state := 3;
       ELSIF cmd = 16#06 THEN state := 2;
       ELSIF cmd = 16#00 THEN state := 1;
       ELSIF cmd = 16#02 THEN state := 5;
       END_IF;
    5: IF v_out = 0.0 THEN
           IF cmd = 16#0F THEN state := 4;
           ELSIF cmd = 16#06 THEN state := 2;
           ELSIF cmd = 16#00 THEN state := 1;
           END_IF;
       END_IF;
    6: IF v_out = 0.0 THEN state := 7; END_IF;
END_CASE;

IF state >= 4 AND state <= 6 THEN
    v_ff := INT_TO_REAL(Setpoint - sp_prev) / SCAN_T;
    pos_err := INT_TO_REAL(Setpoint) - INT_TO_REAL(pos_fb);
    v_out := v_ff + KP * pos_err;
    IF v_out > 120.0 THEN v_out := 120.0; END_IF;
    IF v_out < -120.0 THEN v_out := -120.0; END_IF;
    IF v_ff = 0.0 AND ABS(pos_err) <= 1.5 THEN
        v_out := 0.0;
    END_IF;
ELSIF state = 5 THEN
    IF v_out > 0.0 THEN v_out := MAX(0.0, v_out - QS_DECEL * SCAN_T);
    ELSIF v_out < 0.0 THEN v_out := MIN(0.0, v_out + QS_DECEL * SCAN_T);
    END_IF;
ELSE
    v_out := 0.0;
END_IF;

sp_prev := Setpoint;
v_cmd := REAL_TO_INT(v_out);

sw := 16#0000;
CASE state OF
    1: sw := 16#0040;
    2: sw := 16#0031;
    3: sw := 16#0033;
    4: sw := 16#0037;
    5: sw := 16#0014;
    7: sw := 16#0018;
END_CASE;
IF state = 4 THEN
    IF ABS(pos_err) <= 2.0 AND v_ff = 0.0 THEN
        sw := sw OR 16#0400;
    END_IF;
END_IF;
]]></xhtml:p></ST></body>
      </pou>

      <pou name="INTERP" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire"><type><BOOL/></type></variable>
            <variable name="pos_target"><type><INT/></type></variable>
            <variable name="hold_req"><type><BOOL/></type></variable>
            <variable name="VMAX"><type><REAL/></type><initialValue><simpleValue value="60.0"/></initialValue></variable>
            <variable name="ACCEL"><type><REAL/></type><initialValue><simpleValue value="100.0"/></initialValue></variable>
            <variable name="POSWIN"><type><REAL/></type><initialValue><simpleValue value="2.0"/></initialValue></variable>
          </inputVars>
          <outputVars>
            <variable name="Setpoint"><type><INT/></type><initialValue><simpleValue value="0"/></initialValue></variable>
            <variable name="Busy"><type><BOOL/></type></variable>
            <variable name="Done"><type><BOOL/></type></variable>
          </outputVars>
          <localVars>
            <variable name="pos"><type><REAL/></type><initialValue><simpleValue value="0.0"/></initialValue></variable>
            <variable name="tgt"><type><REAL/></type><initialValue><simpleValue value="0.0"/></initialValue></variable>
            <variable name="vel"><type><REAL/></type><initialValue><simpleValue value="0.0"/></initialValue></variable>
            <variable name="dist"><type><REAL/></type></variable>
            <variable name="stop_d"><type><REAL/></type></variable>
          </localVars>
          <localVars constant="true">
            <variable name="SCAN_T"><type><REAL/></type><initialValue><simpleValue value="0.02"/></initialValue></variable>
          </localVars>
        </interface>
        <body><ST><xhtml:p xmlns:xhtml="http://www.w3.org/1999/xhtml"><![CDATA[
(* 连续跟踪: fire 电平保持期间目标变化即起新轨迹 *)
IF fire AND NOT Busy AND (ABS(INT_TO_REAL(pos_target) - tgt) > 0.499) THEN
    IF pos_target > 100 OR pos_target < 0 THEN
        Done := TRUE;
    ELSE
        tgt := INT_TO_REAL(pos_target);
        Busy := TRUE;
        Done := FALSE;
    END_IF;
END_IF;

IF hold_req THEN
    IF vel > 0.0 THEN vel := MAX(0.0, vel - ACCEL * SCAN_T);
    ELSIF vel < 0.0 THEN vel := MIN(0.0, vel + ACCEL * SCAN_T);
    END_IF;
ELSIF Busy THEN
    dist := tgt - pos;
    stop_d := (vel * vel) / (2.0 * ACCEL);
    IF ABS(dist) <= stop_d THEN
        IF dist >= 0.0 THEN vel := MAX(0.0, vel - ACCEL * SCAN_T);
        ELSE vel := MIN(0.0, vel + ACCEL * SCAN_T);
        END_IF;
        IF vel = 0.0 AND ABS(dist) <= POSWIN THEN
            pos := tgt;
            Busy := FALSE;
            Done := TRUE;
        END_IF;
    ELSE
        IF dist > 0.0 THEN vel := MIN(VMAX, vel + ACCEL * SCAN_T);
        ELSE vel := MAX(-VMAX, vel - ACCEL * SCAN_T);
        END_IF;
    END_IF;
END_IF;

pos := pos + vel * SCAN_T;
Setpoint := REAL_TO_INT(pos);
]]></xhtml:p></ST></body>
      </pou>

      <pou name="MC_POWER" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable"><type><BOOL/></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="cw"><type><WORD/></type></variable>
            <variable name="sw"><type><WORD/></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Status"><type><BOOL/></type></variable>
          </outputVars>
          <localVars>
            <variable name="pstep"><type><INT/></type><initialValue><simpleValue value="0"/></initialValue></variable>
          </localVars>
        </interface>
        <body><ST><xhtml:p xmlns:xhtml="http://www.w3.org/1999/xhtml"><![CDATA[
IF Enable AND pstep = 4 AND (sw AND 16#0004) = 0 AND (sw AND 16#0008) = 0 THEN
    pstep := 0;
END_IF;
IF Enable THEN
    CASE pstep OF
        0: cw := (cw AND 16#00F0) OR 16#0006;  pstep := 1;
        1: IF (sw AND 16#0001) <> 0 THEN cw := (cw AND 16#00F0) OR 16#0007; pstep := 2; END_IF;
        2: IF (sw AND 16#0002) <> 0 THEN cw := (cw AND 16#00F0) OR 16#000F; pstep := 3; END_IF;
        3: IF (sw AND 16#0004) <> 0 THEN pstep := 4; END_IF;
        4: pstep := 4;
    END_CASE;
ELSE
    cw := (cw AND 16#00F0) OR 16#0006;
    pstep := 0;
END_IF;
Status := (sw AND 16#0004) <> 0;
]]></xhtml:p></ST></body>
      </pou>

      <pou name="MC_RESET" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire"><type><BOOL/></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="cw"><type><WORD/></type></variable>
            <variable name="sw"><type><WORD/></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Done"><type><BOOL/></type></variable>
          </outputVars>
          <localVars>
            <variable name="busy"><type><BOOL/></type></variable>
            <variable name="edge_rs"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body><ST><xhtml:p xmlns:xhtml="http://www.w3.org/1999/xhtml"><![CDATA[
IF fire AND NOT edge_rs THEN
    busy := TRUE;
END_IF;
edge_rs := fire;
IF busy THEN
    IF (sw AND 16#0008) <> 0 THEN
        cw := cw OR 16#0080;
    ELSE
        cw := cw AND 16#FF7F;
        busy := FALSE;
    END_IF;
END_IF;
Done := NOT busy AND (sw AND 16#0008) = 0 AND NOT fire;
]]></xhtml:p></ST></body>
      </pou>

      <pou name="MC_STOP" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="fire"><type><BOOL/></type></variable>
          </inputVars>
          <inOutVars>
            <variable name="cw"><type><WORD/></type></variable>
          </inOutVars>
          <outputVars>
            <variable name="Done"><type><BOOL/></type></variable>
          </outputVars>
        </interface>
        <body><ST><xhtml:p xmlns:xhtml="http://www.w3.org/1999/xhtml"><![CDATA[
IF fire THEN
    cw := (cw AND 16#00F0) OR 16#0002;
    Done := FALSE;
ELSE
    Done := TRUE;
END_IF;
]]></xhtml:p></ST></body>
      </pou>

