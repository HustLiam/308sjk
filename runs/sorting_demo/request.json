{
  "schema_version": "1.0.0-draft.1",
  "task_id": "sorting_demo",
  "task_goal": "传送带分拣线：启动/停止自锁回路带急停保护；入口光电对通过的箱体计数，剔除位光电触发后延时 300ms 推出剔除气缸并保持 500ms 回缩；分别统计总量与剔除量；急停触发时传送带立即停止并报警。",
  "io_list": [
    {
      "name": "start_btn",
      "dir": "input",
      "type": "BOOL",
      "range": null,
      "device": "启动按钮（常开脉冲）"
    },
    {
      "name": "stop_btn",
      "dir": "input",
      "type": "BOOL",
      "range": null,
      "device": "停止按钮（常开脉冲）"
    },
    {
      "name": "e_stop",
      "dir": "input",
      "type": "BOOL",
      "range": null,
      "device": "急停按钮（true=触发）"
    },
    {
      "name": "photo_inlet",
      "dir": "input",
      "type": "BOOL",
      "range": null,
      "device": "入口光电传感器（遮挡=true）"
    },
    {
      "name": "photo_reject",
      "dir": "input",
      "type": "BOOL",
      "range": null,
      "device": "剔除位光电传感器（遮挡=true）"
    },
    {
      "name": "motor",
      "dir": "output",
      "type": "BOOL",
      "range": null,
      "device": "传送带电机接触器"
    },
    {
      "name": "pusher",
      "dir": "output",
      "type": "BOOL",
      "range": null,
      "device": "剔除气缸伸出电磁阀"
    },
    {
      "name": "alarm",
      "dir": "output",
      "type": "BOOL",
      "range": null,
      "device": "报警指示灯"
    },
    {
      "name": "total_cnt",
      "dir": "output",
      "type": "INT",
      "range": [
        0,
        32767
      ],
      "unit": "个",
      "device": "通过箱体总数（统计寄存器）"
    },
    {
      "name": "reject_cnt",
      "dir": "output",
      "type": "INT",
      "range": [
        0,
        32767
      ],
      "unit": "个",
      "device": "剔除箱体数（统计寄存器）"
    }
  ],
  "constraints": [
    {
      "id": "C1",
      "kind": "interlock",
      "desc": "急停优先级最高：触发后传送带电机立即失电且报警灯置位，复位后不自启动，需重新按启动按钮"
    },
    {
      "id": "C2",
      "kind": "timing",
      "desc": "剔除序列：剔除位光电上升沿后延时 300ms 推出气缸，推出保持 500ms 后回缩，等待下一箱体"
    },
    {
      "id": "C3",
      "kind": "exception",
      "desc": "急停期间光电信号不参与计数与剔除，防止复位数跳变"
    }
  ],
  "acceptance": [
    {
      "id": "AC1",
      "desc": "剔除位光电检测到箱体后 0.5s 内气缸推出",
      "type": "event_delay",
      "from": {
        "signal": "photo_reject",
        "edge": "rising"
      },
      "to": {
        "signal": "pusher",
        "edge": "rising"
      },
      "op": "<=",
      "value": 0.5,
      "unit": "s"
    },
    {
      "id": "AC2",
      "desc": "被剔除的箱体最终落入剔除料槽",
      "type": "region_containment",
      "asset": "box_reject",
      "region_center": [
        2.0,
        0.8,
        0.15
      ],
      "tolerance": 0.2,
      "check_at": "end"
    },
    {
      "id": "AC3",
      "desc": "急停触发期间传送带电机禁止运行（安全联锁）",
      "type": "forbidden_state",
      "when": {
        "signal": "e_stop",
        "equals": true
      },
      "forbid": {
        "signal": "motor",
        "equals": true
      }
    },
    {
      "id": "AC4",
      "desc": "仿真无发散、物料未掉出地面",
      "type": "sim_health"
    }
  ]
}